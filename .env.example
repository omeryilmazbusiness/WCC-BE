APP_NAME=wodi-crm-be
APP_ENV=local
APP_VERSION=0.1.0

HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://wodi:wodi@localhost:5432/wodi_crm?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=wodi-crm-be

# Use redis://... with docker compose, or memory:// for local without Redis.
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wodi-crm
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
S3_PUBLIC_URL=http://localhost:9000

LOG_LEVEL=debug
LOG_FORMAT=text
