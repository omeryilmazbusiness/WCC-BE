APP_NAME=wodi-crm-be
APP_ENV=local
APP_VERSION=0.1.0

HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:3000

# Host port for docker compose Postgres; keep DATABASE_URL in sync if you change it.
POSTGRES_PORT=5432
DATABASE_URL=postgres://wodi:wodi@localhost:5432/wodi_crm?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars!!
JWT_ACCESS_KEY_ID=a1
# Retired signing keys still accepted for verification: kid:secret,kid:secret
JWT_PREVIOUS_ACCESS_SECRETS=
JWT_ACCESS_TTL=15m
# Refresh TTL is the session idle lifetime; SESSION_ABSOLUTE_TTL caps it (max 90d in production).
JWT_REFRESH_TTL=168h
JWT_ISSUER=wodi-crm-be
JWT_AUDIENCE=wodi-crm-api
SESSION_ABSOLUTE_TTL=720h
SESSION_CHECK_CACHE_TTL=10s
REFRESH_REUSE_GRACE=10s

# Field encryption (AES-256-GCM). Keys are base64 32 bytes; required in production.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# Retired keys still accepted for decryption: kid:base64,kid:base64
ENCRYPTION_PREVIOUS_KEYS=
# Pins passport / verify-token blind indexes so key rotation does not change them.
# Set once and never rotate without POST /v1/ops/encrypt-backfill {"rehash":true}.
ENCRYPTION_BLIND_INDEX_KEY=

# Use redis://... with docker compose, or memory:// for local without Redis.
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wodi-crm
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
S3_PUBLIC_URL=http://localhost:9000

LOG_LEVEL=debug
LOG_FORMAT=text

# FX: optional generic provider for fx.rates_sync (empty = manual rates only).
FX_PROVIDER_URL=
FX_PROVIDER_BASE=USD
FX_PROVIDER_TIMEOUT=10s

# Live exchange rate board (Damascus): LiraScope official/market + ExchangeRate-API reference.
FX_LIVE_ENABLED=true
FX_LOCAL_CURRENCY=SYP
FX_LIVE_PINNED=USD,EUR,SAR
FX_LIVE_CURRENCIES=USD,EUR,SAR,TRY,AED,GBP,JOD,EGP,KWD,QAR,LBP,IQD
FX_LIVE_MARKET_MAX_AGE=48h
FX_LIVE_TIMEOUT=10s
LIRASCOPE_BASE_URL=https://lirascope.syria-cloud.sy/api/v1
ERAPI_BASE_URL=https://open.er-api.com/v6
# Optional; sent as X-Api-Key / X-Api-Secret only when set.
LIRASCOPE_API_KEY=
LIRASCOPE_API_SECRET=
# off | official | market — daily fx.rates_sync also books pinned live mids into fx_rates.
FX_ACCOUNTING_SOURCE=off

# Flight search (Travelpayouts Data API + Aviasales booking links).
# Token: Travelpayouts profile -> API token. Empty disables search (503 flights_not_configured).
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=578591
TRAVELPAYOUTS_MARKET=
TRAVELPAYOUTS_TIMEOUT=10s
